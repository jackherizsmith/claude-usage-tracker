{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Usage",
  "identifier": "co.sourcerie.claude-usage-tracker",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "",
      "width": 380,
      "height": 300,
      "visible": false,
      "decorations": false,
      "alwaysOnTop": true,
      "resizable": true,
      "transparent": true,
      "skipTaskbar": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
